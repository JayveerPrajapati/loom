{
  "id": "daily-digest",
  "name": "Daily news digest",
  "version": 1,
  "settings": {},
  "nodes": [
    {
      "id": "schedule",
      "type": "trigger.cron",
      "typeVersion": 1,
      "name": "Every morning",
      "position": {
        "x": 0,
        "y": 0
      },
      "config": {
        "schedule": "0 8 * * *",
        "timezone": "UTC"
      }
    },
    {
      "id": "news",
      "type": "http.request",
      "typeVersion": 1,
      "name": "Fetch headlines",
      "position": {
        "x": 360,
        "y": 0
      },
      "config": {
        "method": "GET",
        "url": "https://news.example.com/api/headlines"
      },
      "credentials": {
        "http": "cred_http"
      }
    },
    {
      "id": "summarize",
      "type": "code.run",
      "typeVersion": 1,
      "name": "Write the digest",
      "position": {
        "x": 720,
        "y": 0
      },
      "config": {
        "language": "javascript",
        "outputType": "message",
        "source": "const headline = $json.title || 'No news today'; return { text: 'Daily digest: ' + headline };"
      }
    },
    {
      "id": "post",
      "type": "http.request",
      "typeVersion": 1,
      "name": "Post to Slack",
      "position": {
        "x": 1080,
        "y": 0
      },
      "config": {
        "method": "POST",
        "url": "https://example.com/webhook/slack",
        "bodyType": "json",
        "body": {
          "text": "{{ $json.text }}"
        },
        "successCodes": "2xx",
        "failOnError": true
      },
      "credentials": {
        "http": "cred_slack_webhook"
      }
    }
  ],
  "edges": [
    {
      "from": {
        "node": "schedule",
        "port": "main"
      },
      "to": {
        "node": "news",
        "port": "main"
      }
    },
    {
      "from": {
        "node": "news",
        "port": "main"
      },
      "to": {
        "node": "summarize",
        "port": "main"
      }
    },
    {
      "from": {
        "node": "summarize",
        "port": "main"
      },
      "to": {
        "node": "post",
        "port": "main"
      }
    }
  ]
}
