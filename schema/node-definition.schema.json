{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.dev/schema/node-definition.schema.json",
  "title": "Loom Node Definition",
  "description": "The contract a connector or built-in node declares to the compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "typeVersion",
    "category",
    "inputs",
    "outputs",
    "inputType",
    "outputType",
    "config"
  ],
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "typeVersion": { "type": "integer", "minimum": 1 },
    "category": { "enum": ["trigger", "logic", "action", "ai"] },
    "displayName": {
      "type": "string",
      "description": "Human-facing name shown in the node library and as a new node's default name."
    },
    "description": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "inputType": { "$ref": "#/$defs/portType" },
    "outputType": { "$ref": "#/$defs/portType" },
    "outputTypeKey": {
      "type": "string",
      "description": "Config field that overrides outputType (for code and transform nodes)."
    },
    "mappingKinds": {
      "type": "array",
      "items": { "enum": ["item", "body", "query", "headers", "pathParams"] },
      "description": "Configuration Hub mapping kinds this node consumes."
    },
    "effects": {
      "type": "string",
      "description": "Human-readable side-effect contract: pure, or what the node touches."
    },
    "credentials": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "optionalCredentials": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Credentials offered by the editor whose absence is valid."
    },
    "config": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "portType": {
      "enum": ["any", "json", "text", "event", "order", "message", "rows"]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "number", "boolean", "array", "object", "any"] },
        "required": { "type": "boolean" },
        "enum": { "type": "array", "items": { "type": "string" } },
        "default": {
          "description": "Effective-value fallback used only when no profile, override or node value supplies the key."
        },
        "pattern": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "placeholder": { "type": "string" },
        "advanced": { "type": "boolean" },
        "secret": { "type": "boolean" },
        "profileable": {
          "type": "boolean",
          "description": "The field may be supplied by a configuration profile; secret fields are never profileable."
        }
      }
    }
  }
}
